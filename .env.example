# Tweet Voice Cloner env
# Mock mode: use fixture-backed tweet source (no live X API calls)
USE_MOCK_X=true

# X API (only used when USE_MOCK_X=false)
BEARER_TOKEN=

# LLM (generation disabled without it; everything else works)
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# Auth (dev credentials login works without OAuth)
AUTH_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
